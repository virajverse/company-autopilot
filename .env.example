# Viraj Verse - Autonomous Company Operating System
# Runtime Environment Configuration Template

# Server Network Settings
HOST=127.0.0.1
PORT=8008

# Storage Engine ("sqlite" or "file")
COS_STORAGE_BACKEND=sqlite
COS_DATA_DIR=./data

# Autonomous Engine Heartbeat Cadence
HEARTBEAT_INTERVAL_SECS=3

# LLM Gateway Configuration
# Supported providers: Gemini, OpenAI, Anthropic, Ollama, vLLM, LocalAI
COS_LLM_PROVIDER=gemini
COS_LLM_BASE_URL=https://generativelanguage.googleapis.com
COS_LLM_API_KEY=your_api_key_here
COS_LLM_MODEL=gemini-2.0-flash
COS_LLM_TIMEOUT_SECONDS=60
